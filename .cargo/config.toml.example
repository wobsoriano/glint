# Copy this file to .cargo/config.toml (git-ignored) and point both paths at your machine.
# See docs/building.md for where to get cmake and libclang.
#
# Build-time tools for whisper-rs (glint-transcribe): cmake builds whisper.cpp, libclang feeds bindgen.
# VS Build Tools ships cmake. Its Llvm folder has no libclang.dll unless the "C++ Clang tools"
# component is installed, so libclang can come from the PyPI `libclang` 18.1.1 wheel:
#   py -m pip download libclang==18.1.1 --only-binary :all: --no-deps
# then copy libclang-18.1.1.data/platlib/clang/native/libclang.dll from the wheel (a zip) into
# the folder LIBCLANG_PATH names.
[env]
CMAKE = 'C:\Program Files (x86)\Microsoft Visual Studio\2022\BuildTools\Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe'
LIBCLANG_PATH = 'C:\path\to\folder\containing\libclang.dll'
